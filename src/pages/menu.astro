---
import Layout from "../layouts/Layout.astro";
import MenuCard from "../components/MenuCard.astro";
import fetchSanity from '../lib/sanity';
import type Drinks from "../interfaces/drink";

const drinksFromSanity = await fetchSanity<Array<{
  title?: string;
  pris?: string;
  description?: string;
  imageUrl?: string | null;
}>>(`
    *[_type == "Drinks"] {
      title,
      pris,
      description,
        "imageUrl": Realfagsimage.asset->url
    }
`);



const bgForIndex = (i: number) =>
  `/cards_backgrounds/bg${(i % 8) + 1}.svg`;

const data = Array.isArray(drinksFromSanity)
  ? drinksFromSanity
  : [];

const drinks = data.map((item, idx) => ({
  title: item.title ?? "Uten navn",
  pris: item.pris ?? "",
  description: item.description ?? "Beskrivelse kommer senere...",
  imageUrl: item.imageUrl ?? "/fallback.png",
  bgUrl: bgForIndex(idx),
}));
---

<Layout title="Menu" navbarTextColor="#FE710F">
  <main>
    <div class="content">
      <section class="menu-grid">
        {drinks.map((drink) => (
          <MenuCard {...drink} />
        ))}
      </section>
    </div>
  </main>
</Layout>

<style>
  main {
    background-color: #ffffff;
    width: 100%;
    min-height: 100vh;
    font-family: "Gantari", sans-serif;
  }

  .content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 9rem 2rem 3rem;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .content {
      padding-top: 8rem;
    }

    .menu-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 500px) {
    .content {
      padding: 7rem 1rem 2rem;
    }

    .menu-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>