---
import Layout from "../layouts/Layout.astro";
import MenuCard from "../components/MenuCard.astro";
import fetchSanity from "../lib/sanity";
import type Drink from "../interfaces/drink.ts";



const menu = await fetchSanity<Drink[]>(`*[_type == "menu"]{
  title,
  description,
  image{
    asset->{
      url
    }
  }
}`);

const bgForIndex = (i: number) =>
  `/cards_backgrounds/bg${(i % 8) + 1}.svg`;

const drinks = menu.map((item, idx) => {
  const title = item.title ?? "Uten navn";

  const description =
    item.description ?? "Beskrivelse kommer senere";

  const Realfagsimage =
    item.Realfagsimage ?? "/fallback.png";

  return {
    title,
    description,
    Realfagsimage,
    bgUrl: bgForIndex(idx),
  };
});
---

<Layout title="Menu" navbarTextColor="#FE710F">
  <main>
    <div class="content">
      <section class="menu-grid">
        {drinks.map((drink) => (
          <MenuCard {...drink} />
        ))}
      </section>
    </div>
  </main>
</Layout>

<style>
  main {
    background-color: #ffffff;
    width: 100%;
    min-height: 100vh;
    font-family: "Gantari", sans-serif;
  }

  .content {
    max-width: 1280px;
    margin: 0 auto;
    padding: 11rem 2rem 5rem;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(220px, 1fr));
    gap: 3rem 2.5rem;
    justify-items: center;
  }

  @media (max-width: 1200px) {
    .menu-grid {
      grid-template-columns: repeat(3, minmax(220px, 1fr));
    }
  }

  @media (max-width: 900px) {
    .content {
      padding-top: 9rem;
    }

    .menu-grid {
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .content {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .menu-grid {
      grid-template-columns: 1fr;
    }
  }
</style>