---
import Layout from "../layouts/Layout.astro";
import PictureCard from "../components/PictureCard.astro";
import fetchSanity from "../lib/sanity";

const pictureWall = await fetchSanity<{
  images?: {
    alt?: string;
    imageUrl?: string;
  }[];
}>(`
  *[_type == "pictureWall"][0] {
    images[] {
      alt,
      "imageUrl": image.asset->url
    }
  }
`);

const bgForIndex = (i: number) =>
  `/cards_backgrounds/bg${(i % 8) + 1}.svg`;

const images = pictureWall?.images ?? [];

const items = images.map((image, idx) => {
  const rotation = (Math.random() * 4 - 2).toFixed(2);

  return {
    title: image.alt ?? "Bilde",
    caption: image.alt ?? "",
    imageUrl: image.imageUrl ?? "/fallback.png",
    bgUrl: bgForIndex(idx),
    rotation,
  };
});
---

<Layout title="pictureWall" navbarTextColor="#FF5733">
  <main>
    <div class="content">
      <h1 class="pb-16 title">Bildevegg</h1>

      <section class="grid">
        {items.map((item, idx) => (
          <div style={`transform: rotate(${item.rotation}deg);`}>
            <PictureCard {...item} highlighted={idx === 3} />
          </div>
        ))}
      </section>
    </div>
  </main>
</Layout>

<style>
  main {
    background-color: rgb(255, 255, 255);
    width: 100%;
    color: black;
    font-size: 20px;
    line-height: 1.6;
    min-height: 100vh;
    font-family: "Gantari", sans-serif;
    padding-bottom: 3rem;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 3.5rem;
    justify-content: center;
    align-items: flex-start;
  }

  .content {
    padding-top: 11rem;
    padding-left: auto;
    padding-right: auto;
  }

  .title {
    color: #fe710f;
    font-size: 60px;
    font-weight: bolder;
    text-align: center;
    line-height: 70px;
  }
</style>