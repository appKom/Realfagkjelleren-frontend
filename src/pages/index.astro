---
import Layout from '../layouts/Layout.astro';
import type HomePage from '../interfaces/homePage';
import fetchSanity from '../lib/sanity';

const homePage = await fetchSanity<HomePage>(`*[_type == "homePage"][0]{
  title,
  subtitle,
  description,
  images[]{
    alt,
    "url": image.asset->url
  }
}`);
---

<Layout title="Realfagskjelleren" navbarTextColor="#FFFFFF">
  <main class="relative min-h-screen overflow-hidden bg-[#FE710F] text-white">
    <!-- Dekor -->
    <img
      src="/flekkV.svg"
      alt=""
      class="pointer-events-none absolute left-0 top-0 w-28 sm:w-40 md:w-52 lg:w-64"
    />
    <img
      src="/flekkOH.svg"
      alt=""
      class="pointer-events-none absolute right-0 top-0 w-32 sm:w-32 md:w-52 lg:w-52"
    />
    <img
      src="/flekkNH.svg"
      alt=""
      class="pointer-events-none absolute bottom-0 right-0 w-32 sm:w-40 md:w-52 lg:w-64"
    />

    <!-- Innhold -->
    <section class="relative z-10 mx-auto flex min-h-screen max-w-8xl flex-col items-center justify-start px-6 py-36 lg:py-32 text-center sm:px-8 lg:px-12 lg:mt-8">
      <h1 class="font-black leading-relaxed">
        <span class="block whitespace-pre-line text-5xl md:text-[5rem] lg:text-7xl">
          {homePage.title}
        </span>
      </h1>

      <p class="mt-8 max-w-[44ch] text-xl lg:text-2xl leading-7 sm:leading-9">
        <span class="block">{homePage.subtitle}</span>
        <span class="mt-10 block">{homePage.description}</span>
      </p>

      <div class="mt-8">
        <a
          href="/events"
          class="inline-block rounded-full bg-white px-8 py-3 text-sm font-bold text-orange-500 transition hover:bg-orange-100 sm:px-10 sm:text-base"
        >
          SE HVA SOM SKJER
        </a>
      </div>

      <!-- Bilder -->
      <div class="relative mx-auto mt-20 h-[330px] w-full max-w-[900px] sm:h-[420px] lg:h-[500px]">

        {homePage.images?.[0] && (
          <img
            src={homePage.images[0].url}
            alt={homePage.images[0].alt}
            class="absolute left-[2%] top-0 z-10
                  h-[55%] w-[55%]
                  rounded-2xl border-4 border-white
                  object-cover shadow-lg"
          />
        )}

        {homePage.images?.[1] && (
          <img
            src={homePage.images[1].url}
            alt={homePage.images[1].alt}
            class="absolute right-[0%] top-[12%] z-20
                  h-[55%] w-[48%]
                  rounded-2xl border-4 border-white
                  object-cover shadow-lg"
          />
        )}

        {homePage.images?.[2] && (
          <img
            src={homePage.images[2].url}
            alt={homePage.images[2].alt}
            class="absolute bottom-10 left-[40%] z-30
                  h-[43%] w-[42%] -translate-x-1/2
                  rounded-2xl border-4 border-white
                  object-cover shadow-lg"
          />
        )}

      </div>
    </section>
  </main>
</Layout>
