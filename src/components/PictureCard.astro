---
type Props = {
  title: string;
  caption: string
  imageUrl: string;   
  bgUrl: string;      
  highlighted?: boolean;
};

const {title, caption, imageUrl, bgUrl, highlighted = false} = Astro.props;
---

<article
  class:list={[
    "card",
    highlighted && "card--highlighted",
  ]}
  style={`background-image: url('${bgUrl}');`}
>
  <div class="card__inner">
    <div class="card__media">
      <img src={imageUrl} alt={title} loading="lazy" />
    </div>

    <div class="card__caption">
      {caption}
    </div>
  </div>

  <div class="card__overlay" aria-hidden="true"></div>
</article>

<style>
  .card {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    color: rgb(255, 255, 255);
    background-size: cover;
    background-position: center;
    width: 255px;
    height: 320px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
  }

  .card__inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
  }


.card__media {
  overflow: hidden;
  padding-right: 18px;
  padding-left: 18px;
  padding-top: 24px;
  aspect-ratio: 1 / 1;
  }


.card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;        
  object-position: center;
  border-radius: 8px;
}


.card__caption {
  padding-top: 12px;
  display: flex;
  justify-content: center;
  font-weight: 700;
  color: white;
  opacity: 0.95;
  text-align: center;
  text-wrap: balance;
}

</style>
