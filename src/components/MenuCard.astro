---
interface Props {
  title: string;
  description: string;
  imageUrl: string;
  bgUrl: string;
}

const { title, description, imageUrl, bgUrl } = Astro.props;
---

<article class="menu-card" style={`--bg-url: url(${bgUrl})`}>
  <div class="image-wrap">
    <img src={imageUrl} alt={title} loading="lazy" />
  </div>

  <div class="text">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
</article>

<style>
  .menu-card {
    width: 100%;
    min-width:0;
    height: 100%;
    min-height: 340px;
    aspect-ratio: 2 / 3;
    border-radius: 24px;
    background-color: #ff6f00;
    background-image: var(--bg-url);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
    overflow: hidden;
  }

  .image-wrap {
    width: 110px;
    height: 110px;
    max-width: 80%;
    border-radius: 50%;
    overflow: hidden;
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .text {
    width: 100%;
    min-width: 0;
    color: white;
    overflow-wrap: anywhere;
  }

  .text h2 {
    font-family: "Gantari", sans-serif;
    font-size: clamp(1.2rem, 1.6vw, 1.6rem);
    line-height: 1.1;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }

  .text p {
    font-family: "Gantari", sans-serif;
    font-size: 1rem;
    line-height: 1.45;
    font-weight: 700;
    margin: 0;
  }
  .description {
    font-family: "Gantari", sans-serif;
    font-size: 0.9rem;
    line-height: 1.4;
    font-weight: 500;
    margin: 0;
  }

  @media (max-width: 900px) {
    .menu-card {
      min-height: 320px;
      padding: 1.25rem 1rem;
    }
    .image-wrap {
      width: 100px;
      height: 100px;
    }

    .text h2 {
      font-size: 1.3rem;
    }
  }
  @media (max-width: 500px) {
    .menu-card{
      min-height: 300px;
      aspect-ratio: auto;
    }
  }
</style>