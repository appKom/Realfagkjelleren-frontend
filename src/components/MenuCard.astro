---
interface Props {
  title: string;
  pris: string;
  description: string;
  imageUrl: string;
  bgUrl: string;
}

const { title, pris, description, imageUrl, bgUrl } = Astro.props;
---

<article class="menu-card" style={`--bg-url: url("${bgUrl}")`}>
  <div class="image-wrap">
    <img src={imageUrl} alt={title} loading="lazy" />
  </div>

  <div class="text">
    <h2>{title}</h2>
    {pris && <p class="price">{pris} kr</p>}
    <p class="description">{description}</p>
  </div>
</article>

<style>
  .menu-card {
    width: 100%;
    min-width: 0;
    min-height: 320px;
    border-radius: 18px;
    background-color: #ff6f00;
    background-image: var(--bg-url);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    padding: 3.5rem 1rem 1.5rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
    overflow: hidden;
  }

  .image-wrap {
    width: 95px;
    height: 95px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .text {
    width: 100%;
    min-width: 0;
    color: white;
    overflow-wrap: break-word;
  }

  .text h2 {
    font-family: "Gantari", sans-serif;
    font-size: 1.5rem;
    line-height: 1.1;
    font-weight: 800;
    margin: 0 0 0.25rem;
  }

  .price {
    font-family: "Gantari", sans-serif;
    font-size: 1.1rem;
    line-height: 1.2;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .description {
    font-family: "Gantari", sans-serif;
    font-size: 0.8rem;
    line-height: 1.3;
    font-weight: 600;
    margin: 0 auto;
    max-width: 165px;
  }

  @media (max-width: 900px) {
    .menu-card {
      min-height: 320px;
    }
  }

  @media (max-width: 500px) {
    .menu-card {
      min-height: 320px;
    }
  }
</style>
